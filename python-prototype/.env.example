# vision-assistant 配置（复制为 .env 使用；所有变量前缀 VA_）

# ── 服务 ──
VA_HOST=0.0.0.0
VA_PORT=9000
# 任务库/数据目录（SQLite + 运行数据）
VA_DATA_DIR=./data

# ── 鉴权 ──
# 逗号分隔的 API Key 白名单；留空 = 关闭鉴权（仅限本机开发）
VA_API_KEYS=

# ── 下游能力服务（同机部署默认回环地址）──
VA_OCR_BASE_URL=http://127.0.0.1:48763
VA_IPCHECK_BASE_URL=http://127.0.0.1:8001

# ── 下游调用 ──
# 单次下游请求超时（秒）。大图 OCR 单任务 100~200s，不能太短
VA_HTTP_TIMEOUT_SECONDS=600
# 并发闸门：ocr-agent 推理全局串行，保持 1；ipcheck 线程池可稍高
VA_OCR_CONCURRENCY=1
VA_IPCHECK_CONCURRENCY=2

# ocr-agent 大图返回 202 时的轮询参数
VA_OCR_POLL_INTERVAL_SECONDS=2.0
VA_OCR_POLL_TIMEOUT_SECONDS=900.0

# ── 任务回调 ──
VA_TASK_WEBHOOK_MAX_ATTEMPTS=3
VA_TASK_WEBHOOK_BACKOFF_SECONDS=2.0
# 设置后回调携带 X-VA-Signature（HMAC-SHA256(body)）
VA_WEBHOOK_SECRET=

# ── CORS（逗号分隔；C端与 VA 同源部署时留空即可）──
VA_CORS_ORIGINS=
